# The private folder: real packs, the database, rendered media, recordings, keys.
# Never tracked. `npm run check:public` fails if anything under it ever is.
/private/

# The throwaway home `npm run demo` builds for the fictional demo pack.
/.demo/

# Keys, wherever they are.
.env
.env.*
!.env.example

# Packs live in $OF_HOME/packs. The only tracked pack is examples/packs/demo.
/packs/

# Databases and state.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Rendered and downloaded media. docs/screenshots/, the site's icons and the brand marks are the exceptions.
/out/
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.mp4
*.mov
*.webm
!docs/screenshots/*.jpg
!docs/screenshots/*.png
!src/web/static/*.png
!assets/brand/png/*.png

node_modules/
npm-debug.log*
.DS_Store
Thumbs.db

# AI coding tools: settings and worktrees, local to this machine
.claude/
