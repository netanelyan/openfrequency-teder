# open-frequency: every variable the engine reads.
#
# Copy this file to $OF_HOME/.env (./private/.env by default; `npm run init-private`
# does it) and fill in what you have. Nothing here is required to run the engine:
# without keys it runs on recordings and the fake clients, and each real client
# switches on when its key is set. Never put a value in this file itself.

# ---------- where the private data lives ------------------------------------

# The private folder: packs, database, media, recordings, this .env.
# Default ./private (inside the checkout, gitignored). A relative path is resolved
# against the repository root.
OF_HOME=

# "dev" or "prod". dev (the default: a laptop) answers every model call with the
# Claude Code CLI on your subscription (`claude -p`, headless, one call at a time)
# and refuses any call to the Anthropic API unless the command is run with
# --allow-api (each refusal is logged in $OF_HOME/logs/api-refusals.log). prod (the
# server; the service unit sets it) uses the API, with batches and caching.
OF_ENV=

# "live" (real sources, real Claude) or "recorded" (recordings only, no network).
# Default: live in dev, and in prod when ANTHROPIC_API_KEY is set; recorded otherwise.
OF_MODE=

# Force one model backend: "recorded" (for testing), "claude-cli" or "api". An api
# forced in dev is still refused without --allow-api.
OF_LLM=

# The Claude Code CLI, when it is not `claude` on PATH (on Windows the engine finds
# npm's claude.exe by itself).
OF_CLAUDE_BIN=

# How long one CLI call may take before it is stopped, in ms. Default 600000.
OF_CLI_TIMEOUT_MS=

# "off" drafts with direct calls at full price instead of the Message Batches API
# (half price, answers within minutes to hours). Default: batches when Claude is live.
OF_BATCH=

# Who the engine says it is when it reads a source. Wikimedia and SEC ask for a
# contact: "open-frequency/0.1 (+https://your.site; you@your.site)".
OF_USER_AGENT=

# Browser notifications (a TikTok draft waiting, a reminder, a fallback, a duplicate) name
# who sends them to the push services: "mailto:you@your.site" or "https://your.site".
OF_PUSH_CONTACT=

# EDGAR (SEC filings) refuses a reader without a name and an email in its
# User-Agent: "Your Name you@your.site". Only sources that ask for it use it.
SEC_USER_AGENT=

# ---------- Claude (drafting, the bot-score review, source scoring) ---------

# console.anthropic.com > API keys. Without it every drafting call is answered
# from recordings, and the reviewer is the offline heuristic.
ANTHROPIC_API_KEY=

# Only for a key that is not scoped to a workspace (the API then refuses every
# request without one): platform.claude.com > Settings > Workspaces, the ID column
# (wrkspc_...). The Default Workspace's ID is enough: no workspace to create.
# Leave empty for a key scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=

# The model for drafting the outline and the slides. Default claude-sonnet-5-5.
MODEL_DRAFT=

# The model that rewrites a text the reviewer flagged. Default: MODEL_DRAFT.
MODEL_REWRITE=

# The model for the "does this sound like a bot, does it say more than its facts" review. Default claude-sonnet-5-5 (docs/costs.md says why not Haiku).
MODEL_REVIEW=

# The model for sorting and scoring: sources in onboarding, a trend's format. Default claude-haiku-5-5.
MODEL_JUDGE=

# ---------- publishing -------------------------------------------------------

# zernio.com > Settings > API. Publishing and analytics. Without it every account
# publishes with the dry publisher (to disk), whatever its pack says.
ZERNIO_API_KEY=

# Must be "live" for any post to leave through Zernio. Anything else, including
# empty, keeps every account on the dry publisher. A deliberate second switch.
PUBLISH_MODE=

# Zernio's API base. Leave empty for https://zernio.com/api/v1.
ZERNIO_BASE=

# The public https address that serves $OF_HOME/data/public (Zernio and Instagram
# fetch slides by URL). On the VPS this is a Caddy file_server, e.g. https://media.example.com
MEDIA_PUBLIC_BASE_URL=

# ---------- Instagram, directly through Meta's Graph API ---------------------
# For a pack whose pack.json says "publishers": { "instagram": "instagram" }.
# The README's "Instagram" section walks through the Meta app and the tokens.

# Each pack's token, in the variable its pack.json names (instagram.tokenEnv);
# the default name is IG_TOKEN_ and the pack id in capitals, dashes as underscores.
# A Page access token (Facebook Login) or a long-lived Instagram token. Make one
# with `npm run instagram:token -- --pack <id> --short <token>`.
IG_TOKEN_EXAMPLE=

# The Meta app's id and secret (developers.facebook.com > your app > App settings
# > Basic). Used to turn a short token into a long one and to read when a token
# and its data access expire. Never sent anywhere but Meta.
META_APP_ID=

# The Meta app's secret, from the same page.
META_APP_SECRET=

# The Graph API version. Leave empty for v25.0.
GRAPH_API_VERSION=

# ---------- discovery (new accounts, trends) ---------------------------------

# brave.com/search/api: finding authority sites for a new account. $5 per 1,000 queries.
BRAVE_API_KEY=

# console.cloud.google.com: a key restricted to YouTube Data API v3. Shorts that
# work now, with their real view counts. Free, quota only.
YOUTUBE_API_KEY=

# ---------- images -----------------------------------------------------------

# pexels.com/api: free key. Photographs under the Pexels License.
PEXELS_API_KEY=

# unsplash.com/developers: an app's Access Key. Photographs under the Unsplash License.
UNSPLASH_ACCESS_KEY=

# Openverse (api.openverse.org, WordPress.org's index of CC-licensed photographs,
# most of them on Flickr): works with no key, at 20 searches a minute and 200 a
# day. Optional: an access token for a registered application (register at
# api.openverse.org/v1/#tag/auth, then trade its client id and secret for a token
# by hand) for a higher allowance. The engine sends it as a bearer token and
# never asks for one itself; it expires, and an expired one falls back to the
# anonymous allowance.
OPENVERSE_TOKEN=

# ---------- the website ------------------------------------------------------

# Port the website listens on, on 127.0.0.1 only. Default 4700.
PORT=

# The public name Caddy serves the website under (e.g. teder.example.com).
# When set, the site insists on HTTPS through the proxy, and reads only the
# __Secure-of_session cookie there.
PUBLIC_HOST=

# A long random string that signs the forms' CSRF tokens. Changing it only means
# an open page needs a reload before its buttons work.
SESSION_SECRET=

# Where a store's demo page (/s/<slug>) sends "להפעיל את תדר": 1 once accounts'
# sign-up takes new customers; empty sends it to the website's /join instead, so
# nobody lands on a page that does not take them yet. See docs/operator-notes.md.
OF_SIGNUP_OPEN=

# Accounts' sign-up page, https only. Leave empty for
# https://accounts.openfrequency.co.il/signup. Used only with OF_SIGNUP_OPEN=1.
OF_SIGNUP_URL=

# ---------- sign-in: openfrequency-accounts -----------------------------------
# Teder has no login of its own. The browser carries accounts' session cookie
# (__Secure-of_session on .openfrequency.co.il), and Teder asks accounts who it
# belongs to: GET <OF_ACCOUNTS_INTERNAL>/internal/session, on this machine only.
# A page may use an answer up to a minute old; every button asks again.
# The same listener says whether a workspace has paid (/internal/entitlement,
# kept 5 minutes, the last answer standing 24 hours while accounts is down) and
# sends the owners' emails (/internal/notify, with links to PUBLIC_HOST).

# The same value as OF_INTERNAL_TOKEN in openfrequency-accounts' .env, 32
# characters or more. Without it nobody can sign in, no workspace counts as paid,
# and no email is sent.
OF_INTERNAL_TOKEN=

# Where accounts' internal listener is. Leave empty for http://127.0.0.1:4741
# (127.0.0.1, not localhost: accounts listens on IPv4 only).
OF_ACCOUNTS_INTERNAL=

# Where browsers sign in and out. Leave empty for https://accounts.openfrequency.co.il
# (on a laptop with accounts' demo: http://localhost:4740).
OF_ACCOUNTS_URL=

# ---------- the WhatsApp assistant: openfrequency-toran ------------------------
# The assistant reads and acts on a customer's posts through Teder's internal API
# (/internal/assistant/*, on this machine only, never through Caddy), and Teder
# sends it events (a post waiting, the slot, a post out, Sunday's summary).
# docs/assistant-api.md is the contract.

# The secret both sides sign with: the same value in openfrequency-toran's .env,
# 32 characters or more (openssl rand -hex 32). Without it the API answers 503
# and no events are sent.
OF_ASSISTANT_SECRET=

# Where the assistant takes the events, on this machine. Leave empty for
# http://127.0.0.1:4710/internal/teder/events.
OF_TORAN_URL=
